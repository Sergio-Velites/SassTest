# ============================================================================
# FlowHub AI — Environment variables (EXAMPLE — copy to .env, never commit .env)
# ============================================================================
# Every variable used by any app/package must be documented here.
# Real secrets live ONLY in .env locally and in GCP Secret Manager in cloud.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret used to sign session tokens (dev only — generate your own: openssl rand -hex 32)
AUTH_SESSION_SECRET=replace-me-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Database (packages/database)
# ---------------------------------------------------------------------------
# Matches docker-compose.yml defaults for local development
DATABASE_URL=postgresql://flowhub:flowhub_dev_password@localhost:5432/flowhub

# ---------------------------------------------------------------------------
# Jobs / queue (apps/worker)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# AI Gateway (packages/ai-gateway)
# ---------------------------------------------------------------------------
# Provider: mock | openai | anthropic  (mock is the default for local dev & tests)
AI_PROVIDER=mock
# Only needed when AI_PROVIDER is a real provider. NEVER commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Hard monthly cost cap in USD for AI calls (safety guardrail)
AI_MONTHLY_COST_CAP_USD=50

# ---------------------------------------------------------------------------
# Conectores reales (Ciclo 11) — opcionales; sin credenciales siguen los mocks
# ---------------------------------------------------------------------------
# URL pública de la API (callbacks OAuth) y de la web (redirecciones)
API_PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Clave AES-256-GCM para credenciales de conectores: openssl rand -hex 32
CONNECTOR_SECRETS_KEY=
# App OAuth de Slack (api.slack.com/apps) — scopes: chat:write, channels:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Cliente OAuth de Google (console.cloud.google.com) — gmail.readonly, drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test mode). Sin claves, el billing usa el gateway mock local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
