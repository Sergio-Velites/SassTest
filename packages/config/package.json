{
  "name": "@flowhub/config",
  "version": "0.1.0",
  "private": true,
  "description": "Typed, Zod-validated environment configuration for all FlowHub AI apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --test dist/",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.24.0"
  }
}
