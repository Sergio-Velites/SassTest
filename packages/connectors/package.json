{
  "name": "@flowhub/connectors",
  "version": "0.1.0",
  "private": true,
  "description": "Connector interface and mock connectors (Gmail, Slack, Drive, HTTP, inbound webhook) for FlowHub AI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --test dist/",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowhub/shared": "workspace:*",
    "imapflow": "^1.7.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "zod": "^3.24.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1"
  }
}
