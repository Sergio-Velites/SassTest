{
  "name": "@flowhub/api",
  "version": "0.1.0",
  "private": true,
  "description": "FlowHub AI backend API (Fastify + Zod + OpenAPI — scaffolded in Cycle 3, built out in Cycle 5)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@flowhub/config": "workspace:*",
    "@flowhub/connectors": "workspace:*",
    "@flowhub/database": "workspace:*",
    "@flowhub/jobs": "workspace:*",
    "@flowhub/observability": "workspace:*",
    "@flowhub/payments": "workspace:*",
    "@flowhub/shared": "workspace:*",
    "@flowhub/workflow-engine": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  },
  "files": [
    "dist"
  ]
}
