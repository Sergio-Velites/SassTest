# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo
.turbo/

# Environment — NEVER commit real env files
.env
.env.*
!.env.example

# Secrets / credentials — never commit
*.pem
*.key
*.p12
*service-account*.json
credentials*.json

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Terraform
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
infra/terraform/**/.terraform.lock.hcl

# Local databases / dumps
*.sqlite
*.dump
