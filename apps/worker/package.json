{
  "name": "@flowhub/worker",
  "version": "0.1.0",
  "private": true,
  "description": "FlowHub AI background worker (BullMQ consumer behind JobQueue abstraction — built out in Cycle 6)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@flowhub/config": "workspace:*",
    "@flowhub/jobs": "workspace:*",
    "@flowhub/observability": "workspace:*",
    "@flowhub/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
