{
  "name": "flowhub-ai",
  "version": "0.1.0",
  "private": true,
  "description": "FlowHub AI — installable enterprise workflows platform with built-in AI and marketplace",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:reset": "bash scripts/db-reset.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
